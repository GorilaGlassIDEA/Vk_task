# Запустить контейнер с Tarantool 2.11
docker run -d \
  --name tarantool-kv \
  -p 3301:3301 \
  tarantool/tarantool:2.11

# Подключиться к консоли
docker exec -it tarantool-kv tarantoolctl connect 3301


-- 1. Создать спейс KV
box.schema.space.create('KV', {if_not_exists = true})

-- 2. Задать формат полей
box.space.KV:format({
    {name = 'key', type = 'string'},
    {name = 'value', type = 'varbinary', is_nullable = true}
})

-- 3. Создать первичный индекс
box.space.KV:create_index('primary', {
    type = 'tree',
    parts = {'key'},
    if_not_exists = true
})

-- 4. Проверить результат
box.space.KV:count()
-- Должно вернуть 0